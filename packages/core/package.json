{
	"name": "@arbitre/core",
	"version": "0.3.1",
	"type": "module",
	"description": "Rete-inspired production rule engine for declarative state governance",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/surikaterna/arbitre.git",
		"directory": "packages/core"
	},
	"keywords": [
		"rule-engine",
		"rete",
		"production-rules",
		"tms",
		"truth-maintenance",
		"mongodb-query",
		"state-management",
		"declarative",
		"temporal",
		"accumulate"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing/index.d.ts",
				"default": "./dist/testing/index.js"
			},
			"require": {
				"types": "./dist/testing/index.d.cts",
				"default": "./dist/testing/index.cjs"
			}
		},
		"./debug": {
			"import": {
				"types": "./dist/debug/index.d.ts",
				"default": "./dist/debug/index.js"
			},
			"require": {
				"types": "./dist/debug/index.d.cts",
				"default": "./dist/debug/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"src",
		"docs"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/core/src/__tests__"
	},
	"dependencies": {
		"kuery": "^2.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
