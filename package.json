{
	"name": "arbitre",
	"private": true,
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "bun run --filter @arbitre/core prepare:kuery && bun run --filter '*' build:dist",
		"typecheck": "bun run --filter @arbitre/core prepare:kuery && bun run --filter '*' build",
		"test": "bun run --filter @arbitre/core prepare:kuery && vitest run",
		"test:coverage": "vitest run --coverage",
		"test:prepare-kuery": "node test/prepare-kuery-smoke.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test:public-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/expression-public-types.mts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.27.0",
		"@vitest/coverage-v8": "3",
		"fast-check": "^4.8.0",
		"tsup": "^8.3.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0"
	},
	"packageManager": "bun@1.2.0"
}
